# macOS
.DS_Store

# Python
__pycache__/
*.py[cod]
*.egg-info/

# Virtual environments
.venv/
venv/

# Generated PrestaShop API clients (regenerate: python scripts/generate_prestashop_clients.py)
simulator/generated/

# Test / tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Environment variables (real/local values only — committed defaults use *.default.env)
.env
.env.*

# Distribution / build
dist/
build/

# Docker volume data (runtime, not source)
workspaces/*/volumes/

# The public workspace is the production deployment config (real domains, secrets,
# TLS wiring) — kept out of this open-source repo, unlike the local `default` one.
workspaces/public/
backup/

# The lab that measures the employees — staged incidents, campaign runner,
# grader, and every report they produced. Kept out of the public repository for
# the same reason `workspaces/public/` is: what is published is the company and
# the employees, not the rubric they are scored against. An analyst that could
# read the scenarios would be measuring the scenarios.
research/

# What investigations produce, not what they are made of: one record and one
# workspace per run, and the workspace holds a copy of the whole desk. 124 MB
# from a few days of asking. The graded artefacts a report cites live beside
# that report, in research/runs/.
agents/runs/
agents/*/workspaces/
