      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 8,
            "showPoints": "never",
            "lineWidth": 2,
            "gradientMode": "none"
          },
          "color": {
            "mode": "palette-classic"
          },
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "quantile_over_time(0.95, {service=\"gateway\"} | json duration=\"duration\", ua=\"ua\" | __error__=\"\" | ua !~ `archipellabs-probe.*|Blackbox Exporter.*` | unwrap duration [$__interval])",
          "legendFormat": "p95"
        },
        {
          "refId": "B",
          "expr": "quantile_over_time(0.50, {service=\"gateway\"} | json duration=\"duration\", ua=\"ua\" | __error__=\"\" | ua !~ `archipellabs-probe.*|Blackbox Exporter.*` | unwrap duration [$__interval])",
          "legendFormat": "p50"
        }
      ],
      "description": "Extract only the field needed: an unqualified `| json` promotes every field to a label and blows past Loki's series limit."
    },
