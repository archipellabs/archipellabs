        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              },
              {
                "color": "#fab219",
                "value": 20
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "text": {
          "valueSize": 36
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({service=\"gateway\"} | json status=\"status\", ua=\"ua\" | __error__=\"\" | ua !~ `archipellabs-probe.*|Blackbox Exporter.*` | status =~ \"4..\" [$__range]))"
        }
      ],
      "description": "Customer 4xx only \u2014 the uptime probe's own expected 401 on /api/ is excluded by user agent. It fires twice a minute, which put 116 of 127 4xx in the last hour into this tile and would have kept it amber forever for healthy behaviour."
    },
