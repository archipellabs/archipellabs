# Grafana — committed demo defaults. Copy to .env in this folder to override
# locally; that layer is gitignored and optional.

# Demo credentials, same posture as the rest of this workspace. Change them in
# any deployment that is reachable from anywhere.
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin

# Published on its own port (see docker-compose-monitoring.yaml). Grafana still
# has to know its own URL, or the links and redirects it builds are wrong.
GF_SERVER_ROOT_URL=http://localhost:3000/

# Grafana logs every schema migration at info on a fresh volume, which buries
# everything else in `docker compose logs` on a cold start.
GF_LOG_LEVEL=warn

# Nothing here is public and nothing should call home from a lab.
GF_AUTH_ANONYMOUS_ENABLED=false
GF_ANALYTICS_REPORTING_ENABLED=false
GF_ANALYTICS_CHECK_FOR_UPDATES=false
GF_NEWS_NEWS_FEED_ENABLED=false
