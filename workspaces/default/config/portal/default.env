# The portal, in-network. Committed demo defaults; the gitignored `.env` beside
# this file carries its password.
#
# **Its own file, because the portal is not the simulator.** It used to read
# `config/simulator/default.env` for one variable — the bus URL — and that file
# also carries the shop's write-capable Webservice key and OAuth client secret.
# The portal reads the activity database and calls employees; it has no business
# holding credentials that can change the shop.

# The agent bus. Same spelling the employees use: one bus, one vocabulary.
AGENT_REDIS_URL=redis://redis:6379/0
AGENT_NAMESPACE=sim

# Where the cartography cards send a visitor's browser. Each service sits at the
# root of its own name — the gateway carries no context paths.
STOREFRONT_URL=https://shop.archipellabs.test/
BACKOFFICE_URL=https://shop.archipellabs.test/admin-dev/
ANALYTICS_URL=https://tracking.archipellabs.test/
DASHBOARDS_URL=https://grafana.archipellabs.test/

# Whether /ask and /settings ask for the password at all. True by default and in
# this file: the stack is reachable from the browser through the gateway, and a
# page that spends money should not be one URL away from anyone on the network.
# Set false on a laptop where typing it to watch a mock investigation is friction
# with nothing behind it.
PORTAL_AUTH_ENABLED=true
