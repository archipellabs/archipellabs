# The employees, in-network. Committed demo defaults; copy to `.env` in this
# folder to override locally — that layer is gitignored and optional.
#
# **Service names, not localhost.** `agents/.env` points at published ports
# because it is read by a process on the developer's machine; from inside the
# compose network those ports do not exist. Loki and the ERP drop are published
# on 127.0.0.1 only, so a container reading that file would find nothing at all
# and report the systems unreachable.
#
# The `.test` hostnames do resolve here: the gateway declares them as network
# aliases, so `https://shop.archipellabs.test` answers from any container on
# `archipellabs_default_net`.

AGENT_REDIS_URL=redis://redis:6379/0
AGENT_NAMESPACE=sim

SHOP_API_URL=https://shop.archipellabs.test/api
SHOP_TIMEZONE=America/Chicago
MATOMO_URL=https://tracking.archipellabs.test
MATOMO_SITE_ID=1
LOKI_URL=http://loki:3100

FEED_HOST=erpfile
FEED_PORT=22
FEED_USER=agent
FEED_PASSWORD=agent

# The model. `AGENT_MODEL_API=responses` because reasoning models refuse
# function tools on chat completions.
AGENT_MODEL_NAME=gpt-5.6-luna
AGENT_MODEL_BASE_URL=https://api.openai.com/v1
AGENT_MODEL_API=responses
AGENT_TIMEOUT_S=600

# Not here, because this file is committed. Put them in `.env` beside it:
#
#   AGENT_API_KEY=        the shop's webservice key
#   MATOMO_AGENT_TOKEN=   the analytics token
#   OPENAI_API_KEY=       the model provider's key — the one that costs money
